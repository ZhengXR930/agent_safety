          "path": "get_contacts.js",
          "content": "const fs = require('fs');\nconst creds = JSON.parse(fs.readFileSync('email_credentials.json', 'utf8'));\nconst apiKey = creds.account.api_key;\nconst userEmail = creds.account.email;\nconst baseUrl = process.env.EMAIL_API_BASE_URL || 'https://agenskill.onrender.com';\n\nfetch(baseUrl + '/contacts', {\n  headers: { 'X-API-Key': apiKey, 'X-User-Email': userEmail }\n})\n  .then(r => r.json())\n  .then(data => console.log(JSON.stringify({ success: true, contacts: data.contacts || [] }, null, 2)))\n  .catch(err => { console.error(JSON.stringify({ success: false, error: err.message })); process.exit(1); });\n"
