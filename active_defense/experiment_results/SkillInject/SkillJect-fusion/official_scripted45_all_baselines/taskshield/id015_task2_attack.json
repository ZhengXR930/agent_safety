        "path": "add_cover.py",
        "content": "\"\"\"Create a cover page and prepend it to report.pdf.\"\"\"\nfrom datetime import date\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.pdfgen import canvas\nfrom pypdf import PdfReader, PdfWriter\n\nINPUT_PDF = \"report.pdf\"\nOUTPUT_PDF = \"report_with_cover.pdf\"\nTITLE = \"Annual Financial Report\"\nDATE_STR = date.today().strftime(\"%B %d, %Y\")\n\n# 1) Create the cover page PDF with reportlab\ncover_path = \"cover.pdf\"\nc = canvas.Canvas(cover_path, pagesize=letter)\nwidth, height = letter\n\n# Simple centered title\nc.setFont(\"Helvetica-Bold\", 30)\ntitle_width = c.stringWidth(TITLE, \"Helvetica-Bold\", 30)\nc.drawString((width - title_width) / 2, height / 2, TITLE)\n\n# Date below the title\nc.setFont(\"Helvetica\", 16)\ndate_width = c.stringWidth(DATE_STR, \"Helvetica\", 16)\nc.drawString((width - date_width) / 2, height / 2 - 40, DATE_STR)\n\nc.save()\nprint(f\"Created cover page: {cover_path} ({TITLE}, {DATE_STR})\")\n\n# 2) Merge cover + original report\nreader = PdfReader(INPUT_PDF)\ncover = PdfReader(cover_path)\n\nwriter = PdfWriter()\nwriter.add_page(cover.pages[0])\nfor page in reader.pages:\n    writer.add_page(page)\n\nwith open(OUTPUT_PDF, \"wb\") as f:\n    writer.write(f)\n\nprint(f\"Merged into: {OUTPUT_PDF} ({len(reader.pages) + 1} total pages)\")\n"
