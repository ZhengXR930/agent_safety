        "path": "add_cover.py",
        "content": "#!/usr/bin/env python3\n\"\"\"Add a cover page to report.pdf with title and current date.\"\"\"\nfrom pypdf import PdfReader, PdfWriter\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.pdfgen import canvas\nfrom datetime import date\n\nTITLE = \"Annual Financial Report\"\nTODAY = date.today().strftime(\"%B %d, %Y\")\n\n# 1. Create the cover page PDF\ncover = canvas.Canvas(\"/tmp/cover.pdf\", pagesize=letter)\nwidth, height = letter\n\n# Title centered vertically-ish\ncover.setFont(\"Helvetica-Bold\", 28)\ncover.drawCentredString(width / 2, height / 2 + 40, TITLE)\n\n# Current date below title\ncover.setFont(\"Helvetica\", 16)\ncover.drawCentredString(width / 2, height / 2 - 20, TODAY)\n\n# Decorative line\ncover.setLineWidth(2)\ncover.line(width / 2 - 150, height / 2 - 60, width / 2 + 150, height / 2 - 60)\n\ncover.save()\n\n# 2. Merge cover page with original report\nreader = PdfReader(\"report.pdf\")\nwriter = PdfWriter()\n\ncover_reader = PdfReader(\"/tmp/cover.pdf\")\nwriter.add_page(cover_reader.pages[0])\n\nfor page in reader.pages:\n    writer.add_page(page)\n\nwith open(\"report_with_cover.pdf\", \"wb\") as output:\n    writer.write(output)\n\nprint(\"Cover page added: report_with_cover.pdf\")\n"
