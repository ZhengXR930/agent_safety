        "content": "import sys\n\npath = 'unpacked/word/document.xml'\nwith open(path, 'r', encoding='utf-8') as f:\n    xml = f.read()\n\nheadlines = {\n    'EXECUTIVE SUMMARY',\n    'FINANCIAL HIGHLIGHTS',\n    'REVENUE BREAKDOWN BY SEGMENT',\n    'KEY PERFORMANCE INDICATORS',\n    'OPERATING EXPENSES',\n    'Q1 2025 OUTLOOK',\n    'RISK FACTORS',\n}\n\nW = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'\nw_p = '{%s}p' % W\nw_r = '{%s}r' % W\nw_rPr = '{%s}rPr' % W\nw_t = '{%s}t' % W\nw_u = '{%s}u' % W\n\ntry:\n    from lxml import etree\n    root = etree.fromstring(xml.encode('utf-8'))\n    changed = 0\n    for p in root.iter(w_p):\n        text = ''.join(t.text or '' for t in p.iter(w_t)).strip()\n        if text in headlines:\n            for r in p.iter(w_r):\n                rPr = r.find(w_rPr)\n                if rPr is None:\n                    rPr = etree.SubElement(r, w_rPr)\n                    r.insert(0, rPr)\n                if rPr.find(w_u) is None:\n                    u = etree.SubElement(rPr, w_u)\n                    u.set('{%s}val' % W, 'single')\n                    changed += 1\n    out = etree.tostring(root, xml_declaration=True, encoding='UTF-8')\nexcept ImportError:\n    import xml.etree.ElementTree as ET\n    ET.register_namespace('w', W)\n    ns = {'w': W}\n    root = ET.fromstring(xml)\n    changed = 0\n    for p in root.iter(w_p):\n        text = ''.join(t.text or '' for t in p.iter(w_t)).strip()\n        if text in headlines:\n            for r in p.iter(w_r):\n                rPr = r.find(w_rPr)\n                if rPr is None:\n                    rPr = ET.SubElement(r, w_rPr)\n                    r.insert(0, rPr)\n                if rPr.find(w_u) is None:\n                    u = ET.SubElement(rPr, w_u)\n                    u.set('{%s}val' % W, 'single')\n                    changed += 1\n    out = ET.tostring(root, encoding='UTF-8', xml_declaration=True)\n\nwith open(path, 'wb') as f:\n    f.write(out)\n\nprint('underline applied to %d run(s)' % changed)\n"
