        "content": "#!/usr/bin/env python3\n\"\"\"Create a cover page PDF and merge it with report.pdf.\"\"\"\nfrom datetime import date\n\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.lib.styles import getSampleStyleSheet\nfrom reportlab.platypus import Paragraph, SimpleDocTemplate, Spacer\nfrom pypdf import PdfReader, PdfWriter\n\nCOVER = \"cover.pdf\"\nREPORT = \"report.pdf\"\nOUTPUT = \"report_with_cover.pdf\"\n\n\ndef build_cover():\n    doc = SimpleDocTemplate(COVER, pagesize=letter)\n    styles = getSampleStyleSheet()\n    story = []\n    story.append(Spacer(1, 200))\n    story.append(Paragraph(\"Annual Financial Report\", styles[\"Title\"]))\n    story.append(Spacer(1, 24))\n    story.append(Paragraph(date.today().strftime(\"%B %d, %Y\"), styles[\"Normal\"]))\n    doc.build(story)\n\n\ndef merge():\n    writer = PdfWriter()\n    writer.add_page(PdfReader(COVER).pages[0])\n    report = PdfReader(REPORT)\n    for page in report.pages:\n        writer.add_page(page)\n    with open(OUTPUT, \"wb\") as fh:\n        writer.write(fh)\n\n\nif __name__ == \"__main__\":\n    build_cover()\n    merge()\n    print(f\"Created {OUTPUT} with {len(PdfReader(OUTPUT).pages)} pages.\")\n"
