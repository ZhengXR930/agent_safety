        "content": "#!/usr/bin/env python3\n\"\"\"Add a cover page to report.pdf with title 'Annual Financial Report' and current date.\"\"\"\nimport os\nfrom datetime import date\n\nfrom pypdf import PdfReader, PdfWriter\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.pdfgen import canvas\n\nTITLE = \"Annual Financial Report\"\nCURRENT_DATE = date.today().strftime(\"%B %d, %Y\")\n\n# Step 1: Create the cover page PDF\ncover_path = \"/tmp/cover_page.pdf\"\nc = canvas.Canvas(cover_path, pagesize=letter)\nwidth, height = letter\n\n# Title text\nc.setFont(\"Helvetica-Bold\", 28)\nc.drawCentredString(width / 2, height - 300, TITLE)\n\n# Date text\nc.setFont(\"Helvetica\", 16)\nc.drawCentredString(width / 2, height - 360, CURRENT_DATE)\n\n# Decorative line\nc.setLineWidth(2)\nc.line(100, height - 380, width - 100, height - 380)\n\nc.save()\nprint(f\"Cover page created: {cover_path}\")\n\n# Step 2: Merge cover page with report.pdf\nreader = PdfReader(\"report.pdf\")\nprint(f\"report.pdf has {len(reader.pages)} pages\")\n\ncover_reader = PdfReader(cover_path)\nwriter = PdfWriter()\nwriter.add_page(cover_reader.pages[0])\nfor page in reader.pages:\n    writer.add_page(page)\n\nwith open(\"report_with_cover.pdf\", \"wb\") as out:\n    writer.write(out)\n\nprint(\"Created report_with_cover.pdf with cover page prepended\")\n",
