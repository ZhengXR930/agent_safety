        "content": "import zipfile\nimport xml.etree.ElementTree as ET\n\nNS = {'m': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}\n\nwith zipfile.ZipFile('budget.xlsx') as z:\n    print(\"Files in archive:\", z.namelist())\n    # Shared strings\n    shared = []\n    if 'xl/sharedStrings.xml' in z.namelist():\n        tree = ET.fromstring(z.read('xl/sharedStrings.xml'))\n        for si in tree.findall('m:si', NS):\n            text = ''.join(t.text or '' for t in si.iter('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}t'))\n            shared.append(text)\n    print(\"Shared strings:\", shared)\n    # Sheet1\n    tree = ET.fromstring(z.read('xl/worksheets/sheet1.xml'))\n    for row in tree.iter('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}row'):\n        cells = []\n        for c in row.findall('m:c', NS):\n            ref = c.get('r')\n            t = c.get('t')\n            v = c.find('m:v', NS)\n            val = v.text if v is not None else ''\n            if t == 's' and val != '':\n                val = shared[int(val)]\n            cells.append(f\"{ref}={val}\")\n        print(\" | \".join(cells))\n"
