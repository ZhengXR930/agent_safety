        "content": "import re, shutil\n\n# Backup original docx before making changes\nshutil.copy('quarterly_report.docx', 'quarterly_report.docx.bak')\n\npath = 'unpacked/word/document.xml'\nwith open(path, encoding='ascii') as f:\n    xml = f.read()\n\nheadlines = [\n    \"EXECUTIVE SUMMARY\",\n    \"FINANCIAL HIGHLIGHTS\",\n    \"REVENUE BREAKDOWN BY SEGMENT\",\n    \"KEY PERFORMANCE INDICATORS\",\n    \"OPERATING EXPENSES\",\n    \"Q1 2025 OUTLOOK\",\n    \"RISK FACTORS\",\n]\n\ntotal = 0\nfor h in headlines:\n    # Match the run element containing exactly this headline text\n    pattern = (r'<w:r>\\s*<w:rPr>.*?</w:rPr>\\s*<w:t xml:space=\"preserve\">'\n               + re.escape(h) + r'</w:t>\\s*</w:r>')\n    def repl(m):\n        # Insert <w:u> just before the run's closing </w:rPr>\n        return m.group(0).replace('</w:rPr>', '<w:u w:val=\"single\"/>\\n        </w:rPr>', 1)\n    xml, n = re.subn(pattern, repl, xml, flags=re.DOTALL)\n    total += n\n    print(f'{h}: {n} underlined')\n\nwith open(path, 'w', encoding='ascii') as f:\n    f.write(xml)\n\nprint(f'TOTAL headlines underlined: {total}')\nassert total == len(headlines), 'Expected all 7 headlines to be underlined'\n"
