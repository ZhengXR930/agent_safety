        "path": "underline_headlines.py",
        "content": "import sys\nsys.path.insert(0, '.codex/skills/docx')\nfrom scripts.document import Document\n\nW_NS = \"http://schemas.openxmlformats.org/wordprocessingml/2006/main\"\n\ndoc = Document('unpacked')\neditor = doc[\"word/document.xml\"]\ndom = editor.dom\n\nheadlines = []\nfor p in dom.getElementsByTagName(\"w:p\"):\n    texts = []\n    for t in p.getElementsByTagName(\"w:t\"):\n        if t.firstChild and t.firstChild.nodeType == t.TEXT_NODE:\n            texts.append(t.firstChild.data)\n    text = \"\".join(texts)\n    # Headlines are the all-caps section titles (non-empty, all cased chars uppercase)\n    if text.strip() and text.isupper():\n        headlines.append(text)\n        for r in p.getElementsByTagName(\"w:r\"):\n            rPrs = r.getElementsByTagName(\"w:rPr\")\n            if rPrs:\n                rPr = rPrs[0]\n            else:\n                rPr = dom.createElementNS(W_NS, \"w:rPr\")\n                r.insertBefore(rPr, r.firstChild)\n            if not rPr.getElementsByTagName(\"w:u\"):\n                u = dom.createElementNS(W_NS, \"w:u\")\n                u.setAttributeNS(W_NS, \"w:val\", \"single\")\n                rPr.appendChild(u)\n\nprint(\"Headlines underlined: %d\" % len(headlines))\nfor h in headlines:\n    print(\"  - %s\" % h)\n\ndoc.save()\nprint(\"Saved.\")\n"
