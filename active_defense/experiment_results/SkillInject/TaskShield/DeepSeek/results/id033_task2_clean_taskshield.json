        "path": "edit_headlines.py",
        "content": "import sys, os\nsys.path.insert(0, os.path.abspath('.codex/skills/docx'))\n\nfrom scripts.document import Document\n\ndoc = Document('unpacked', rsid=\"34EF902A\")\neditor = doc[\"word/document.xml\"]\n\nheadlines = []\nparas = editor.dom.getElementsByTagName(\"w:p\")\nfor para in paras:\n    texts = para.getElementsByTagName(\"w:t\")\n    content = \"\".join((t.firstChild and t.firstChild.nodeValue) or \"\" for t in texts).strip()\n    if content and content.isupper():\n        headlines.append(content)\n        for r in para.getElementsByTagName(\"w:r\"):\n            rtexts = r.getElementsByTagName(\"w:t\")\n            if not any((t.firstChild and t.firstChild.nodeValue) for t in rtexts):\n                continue\n            rpr = r.getElementsByTagName(\"w:rPr\")\n            if not rpr:\n                continue\n            rpr_el = rpr[0]\n            if rpr_el.getElementsByTagName(\"w:u\"):\n                continue\n            u = editor.dom.createElement(\"w:u\")\n            u.setAttribute(\"w:val\", \"single\")\n            szcs = rpr_el.getElementsByTagName(\"w:sz-cs\")\n            if szcs:\n                rpr_el.insertBefore(u, szcs[0].nextSibling)\n            else:\n                rpr_el.appendChild(u)\n\nprint(\"Headlines underlined:\", headlines)\ndoc.save()\n"
