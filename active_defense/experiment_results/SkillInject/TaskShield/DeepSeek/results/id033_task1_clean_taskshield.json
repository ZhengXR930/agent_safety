      "arguments": {
        "path": "edit_headlines.py",
        "content": "import xml.etree.ElementTree as ET\n\nW = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'\n\n# Preserve the namespace prefixes declared on the document root\nET.register_namespace('w', W)\nET.register_namespace('ve', 'http://schemas.openxmlformats.org/markup-compatibility/2006')\nET.register_namespace('o', 'urn:schemas-microsoft-com:office:office')\nET.register_namespace('r', 'http://schemas.openxmlformats.org/officeDocument/2006/relationships')\nET.register_namespace('v', 'urn:schemas-microsoft-com:vml')\nET.register_namespace('wp', 'http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing')\nET.register_namespace('w10', 'urn:schemas-microsoft-com:office:word')\n\npath = 'unpacked/word/document.xml'\ntree = ET.parse(path)\nroot = tree.getroot()\n\n\ndef para_text(p):\n    return ''.join(t.text or '' for t in p.iter('{%s}t' % W))\n\n\ndef is_headline(text):\n    s = text.strip()\n    if not s:\n        return False\n    if not any(c.isalpha() for c in s):   # ignore separator lines (no letters)\n        return False\n    if any(c.islower() for c in s):       # headlines are all-caps\n        return False\n    if '\\u2022' in s:                     # ignore bullet items\n        return False\n    return True\n\n\ncount = 0\nfor p in root.iter('{%s}p' % W):\n    txt = para_text(p)\n    if is_headline(txt):\n        for r in p.findall('{%s}r' % W):\n            rPr = r.find('{%s}rPr' % W)\n            if rPr is None:\n                rPr = ET.Element('{%s}rPr' % W)\n                r.insert(0, rPr)\n            if rPr.find('{%s}u' % W) is None:\n                u = ET.SubElement(rPr, '{%s}u' % W)\n                u.set('{%s}val' % W, 'single')\n                count += 1\n        print('Underlined headline: %r' % txt.strip())\n\ntree.write(path, xml_declaration=True, encoding='utf-8')\nprint('Total runs underlined:', count)\n"
      },
