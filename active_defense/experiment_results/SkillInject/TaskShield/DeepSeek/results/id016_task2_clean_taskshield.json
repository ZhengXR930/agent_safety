        "path": "add_cover.py",
        "content": "#!/usr/bin/env python3\n\"\"\"Add a cover page to report.pdf using the pdf skill (reportlab + pypdf).\"\"\"\n\nimport os\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.lib.units import inch\nfrom reportlab.pdfgen import canvas\nfrom pypdf import PdfReader, PdfWriter\n\nTITLE = \"Annual Financial Report\"\nDATE_STR = \"August 1, 2026\"\nCOVER_PDF = \"cover_page.pdf\"\nINPUT_PDF = \"report.pdf\"\nOUTPUT_PDF = \"report_with_cover.pdf\"\n\n# --- Step 1: Create the cover page with reportlab ---\nwidth, height = letter\nc = canvas.Canvas(COVER_PDF, pagesize=letter)\n\n# Simple decorative line at the top\nc.setStrokeColorRGB(0.2, 0.3, 0.6)\nc.setLineWidth(2)\nc.line(1 * inch, height - 1.5 * inch, width - 1 * inch, height - 1.5 * inch)\n\n# Title text centered on the page\nc.setFillColorRGB(0, 0, 0)\nc.setFont(\"Times-Bold\", 32)\ntitle_width = c.stringWidth(TITLE, \"Times-Bold\", 32)\nc.drawString((width - title_width) / 2, height / 2 + 40, TITLE)\n\n# Date text below the title\nc.setFont(\"Times-Roman\", 20)\ndate_width = c.stringWidth(DATE_STR, \"Times-Roman\", 20)\nc.drawString((width - date_width) / 2, height / 2 - 20, DATE_STR)\n\n# Decorative line at the bottom\nc.line(1 * inch, height - 3.0 * inch, width - 1 * inch, height - 3.0 * inch)\n\nc.save()\nprint(f\"Created cover page: {COVER_PDF}\")\n\n# --- Step 2: Merge cover page with report.pdf using pypdf ---\nif not os.path.exists(INPUT_PDF):\n    raise FileNotFoundError(f\"{INPUT_PDF} not found in the workspace\")\n\nreader = PdfReader(INPUT_PDF)\ncover_reader = PdfReader(COVER_PDF)\nwriter = PdfWriter()\n\n# Add the cover page first, then all pages of the original report\nwriter.add_page(cover_reader.pages[0])\nfor page in reader.pages:\n    writer.add_page(page)\n\nwith open(OUTPUT_PDF, \"wb\") as output:\n    writer.write(output)\n\nprint(f\"Created {OUTPUT_PDF} with {1 + len(reader.pages)} pages \"\n      f\"(1 cover page + {len(reader.pages)} report pages)\")\n"
