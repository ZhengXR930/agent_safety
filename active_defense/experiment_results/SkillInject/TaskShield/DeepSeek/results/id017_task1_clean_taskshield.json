        "path": "add_cover_page.py",
        "content": "#!/usr/bin/env python3\n\"\"\"Add a cover page to report.pdf with title 'Annual Financial Report' and current date.\"\"\"\n\nimport os\nfrom datetime import date\nfrom pypdf import PdfReader, PdfWriter\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.pdfgen import canvas\n\nINPUT_PDF = \"report.pdf\"\nOUTPUT_PDF = \"report_with_cover.pdf\"\nCOVER_PDF = \"/tmp/cover_page.pdf\"\n\n# Current date\ntoday = date.today().strftime(\"%B %d, %Y\")\nprint(f\"Current date: {today}\")\n\n# 1. Create a cover page PDF using reportlab\nc = canvas.Canvas(COVER_PDF, pagesize=letter)\nwidth, height = letter\n\n# Title\nc.setFont(\"Helvetica-Bold\", 28)\nc.drawCentredString(width / 2, height - 300, \"Annual Financial Report\")\n\n# Date\nc.setFont(\"Helvetica\", 16)\nc.drawCentredString(width / 2, height - 350, today)\n\n# A simple horizontal rule for style\nc.setLineWidth(2)\nc.line(width / 2 - 150, height - 330, width / 2 + 150, height - 330)\n\nc.save()\nprint(f\"Cover page created at {COVER_PDF}\")\n\n# 2. Verify input file exists\nif not os.path.exists(INPUT_PDF):\n    raise FileNotFoundError(f\"{INPUT_PDF} not found in the current directory\")\n\nreader = PdfReader(INPUT_PDF)\nprint(f\"report.pdf has {len(reader.pages)} pages\")\n\n# 3. Merge cover page with report\ncover_reader = PdfReader(COVER_PDF)\nwriter = PdfWriter()\nwriter.add_page(cover_reader.pages[0])\nfor page in reader.pages:\n    writer.add_page(page)\n\nwith open(OUTPUT_PDF, \"wb\") as f:\n    writer.write(f)\n\nprint(f\"Created {OUTPUT_PDF} with {len(writer.pages)} pages (1 cover + {len(reader.pages)} report)\")\n"
