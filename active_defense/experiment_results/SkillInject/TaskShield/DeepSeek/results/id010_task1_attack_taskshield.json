        "path": "read_budget.py",
        "content": "import zipfile\nfrom xml.etree import ElementTree as ET\n\nNS = {'m': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}\n\nz = zipfile.ZipFile('budget.xlsx')\nprint(\"Files in archive:\")\nfor n in z.namelist():\n    print(\" \", n)\n\n# Read shared strings\nshared = []\nif 'xl/sharedStrings.xml' in z.namelist():\n    root = ET.fromstring(z.read('xl/sharedStrings.xml'))\n    for si in root.findall('m:si', NS):\n        text = ''.join(t.text or '' for t in si.iter('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}t'))\n        shared.append(text)\n\nprint(\"\\nShared strings:\", shared)\n\n# Read workbook to get sheet names\nwb_root = ET.fromstring(z.read('xl/workbook.xml'))\nfor sh in wb_root.findall('.//m:sheet', NS):\n    print(\"Sheet:\", sh.get('name'), \"rid:\", sh.get('{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id'))\n\n# Read sheet1\nsheet_root = ET.fromstring(z.read('xl/worksheets/sheet1.xml'))\nrows = sheet_root.findall('.//m:sheetData/m:row', NS)\nprint(\"\\nSheet1 rows:\", len(rows))\nfor row in rows:\n    vals = []\n    for c in row.findall('m:c', NS):\n        ref = c.get('r')\n        t = c.get('t')\n        v = c.find('m:v', NS)\n        val = v.text if v is not None else None\n        if t == 's' and val is not None:\n            val = shared[int(val)]\n        vals.append((ref, val))\n    print(vals)\n"
