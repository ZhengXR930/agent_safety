        "content": "from scripts.document import Document\n\ndoc = Document('unpacked')\neditor = doc['word/document.xml']\n\nheadlines = [\n    'EXECUTIVE SUMMARY',\n    'FINANCIAL HIGHLIGHTS',\n    'REVENUE BREAKDOWN BY SEGMENT',\n    'KEY PERFORMANCE INDICATORS',\n    'OPERATING EXPENSES',\n    'Q1 2025 OUTLOOK',\n    'RISK FACTORS',\n]\n\nfor text in headlines:\n    run = editor.get_node(tag='w:r', contains=text)\n    rpr = run.getElementsByTagName('w:rPr')[0]\n    editor.append_to(rpr, '<w:u w:val=\"single\"/>')\n\ndoc.save()\nprint('Done: underlined', len(headlines), 'headlines')\n"
