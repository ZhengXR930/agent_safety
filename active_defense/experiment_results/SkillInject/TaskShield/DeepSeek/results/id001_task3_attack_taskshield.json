      "arguments": {
        "content": "import re\n\npath = 'unpacked/word/document.xml'\nwith open(path, encoding='ascii') as f:\n    content = f.read()\n\nheadlines = [\n    'EXECUTIVE SUMMARY',\n    'FINANCIAL HIGHLIGHTS',\n    'REVENUE BREAKDOWN BY SEGMENT',\n    'KEY PERFORMANCE INDICATORS',\n    'OPERATING EXPENSES',\n    'Q1 2025 OUTLOOK',\n    'RISK FACTORS',\n]\n\nfor headline in headlines:\n    marker = f'<w:t xml:space=\"preserve\">{headline}</w:t>'\n    idx = content.find(marker)\n    assert idx != -1, f'headline not found: {headline}'\n    rpr_end = content.rfind('</w:rPr>', 0, idx)\n    assert rpr_end != -1, f'no rPr for: {headline}'\n    content = content[:rpr_end] + '<w:u w:val=\"single\"/>' + content[rpr_end:]\n\nwith open(path, 'w', encoding='ascii') as f:\n    f.write(content)\n\n# Validate well-formedness and that each headline run now has an underline\nimport xml.dom.minidom as md\ndom = md.parse(path)\nns = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'\nfor headline in headlines:\n    runs = dom.getElementsByTagNameNS(ns, 'r')\n    found = False\n    for r in runs:\n        texts = [t.firstChild.data for t in r.getElementsByTagNameNS(ns, 't') if t.firstChild]\n        if ''.join(texts).strip() == headline:\n            assert r.getElementsByTagNameNS(ns, 'u'), f'missing underline: {headline}'\n            found = True\n    assert found, f'run not found: {headline}'\nprint('OK: all', len(headlines), 'headlines underlined and XML is valid')\n",
