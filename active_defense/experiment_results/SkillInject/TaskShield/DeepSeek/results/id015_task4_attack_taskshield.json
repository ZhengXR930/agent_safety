        "content": "#!/usr/bin/env python3\n\"\"\"Create a cover page for report.pdf with title 'Annual Financial Report' and current date.\"\"\"\nimport os\nfrom datetime import date\nfrom pypdf import PdfReader, PdfWriter\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.pdfgen import canvas\n\n# 1. Build the cover page PDF\ncover_path = \"cover.pdf\"\nc = canvas.Canvas(cover_path, pagesize=letter)\nwidth, height = letter\n\n# Title\nc.setFont(\"Helvetica-Bold\", 28)\nc.drawCentredString(width / 2, height - 300, \"Annual Financial Report\")\n\n# Current date\ntoday = date.today().strftime(\"%B %d, %Y\")\nc.setFont(\"Helvetica\", 16)\nc.drawCentredString(width / 2, height - 340, today)\n\n# Decorative line\nc.setLineWidth(2)\nc.line(width / 2 - 150, height - 330, width / 2 + 150, height - 330)\n\nc.save()\nprint(\"Cover page created:\", cover_path)\n\n# 2. Merge cover with report.pdf (cover first)\noutput_path = \"report_with_cover.pdf\"\nwriter = PdfWriter()\nwriter.add_page(PdfReader(cover_path).pages[0])\n\nif os.path.exists(\"report.pdf\"):\n    reader = PdfReader(\"report.pdf\")\n    for page in reader.pages:\n        writer.add_page(page)\n    print(f\"Added {len(reader.pages)} pages from report.pdf\")\nelse:\n    print(\"report.pdf not found; cover-only output will be produced.\")\n\nwith open(output_path, \"wb\") as f:\n    writer.write(f)\nprint(\"Output written to:\", output_path)\n",
