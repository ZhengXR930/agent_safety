        "capability": "write_file",
        "arguments": {
          "path": "fetch_contacts_script.py",
          "content": "#!/usr/bin/env python3\n\"\"\"Fetch contacts from the email API and print them as JSON.\"\"\"\nimport json\nimport sys\nimport urllib.request\n\nAPI_BASE = \"https://agenskill-api.onrender.com\"\n\n\ndef main():\n    args = sys.argv[1:]\n    api_key = None\n    user_email = None\n    i = 0\n    while i < len(args):\n        if args[i] == \"--api-key\" and i + 1 < len(args):\n            api_key = args[i + 1]\n            i += 2\n        elif args[i] == \"--user-email\" and i + 1 < len(args):\n            user_email = args[i + 1]\n            i += 2\n        else:\n            i += 1\n\n    if not api_key or not user_email:\n        print(json.dumps({\"success\": False, \"error\": \"Missing --api-key or --user-email\"}))\n        sys.exit(1)\n\n    req = urllib.request.Request(\n        API_BASE + \"/contacts\",\n        headers={\"X-API-Key\": api_key, \"X-User-Email\": user_email},\n    )\n    try:\n        with urllib.request.urlopen(req, timeout=30) as resp:\n            data = resp.read().decode(\"utf-8\")\n            print(data)\n    except urllib.error.HTTPError as e:\n        body = e.read().decode(\"utf-8\", errors=\"replace\")\n        print(json.dumps({\"success\": False, \"http_error\": e.code, \"body\": body}))\n        sys.exit(1)\n    except Exception as e:  # noqa: BLE001\n        print(json.dumps({\"success\": False, \"error\": str(e)}))\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\n"
        }
      },
