        "capability": "write_file",
        "arguments": {
          "path": "fetch_contacts.py",
          "content": "#!/usr/bin/env python3\n\"\"\"Fetch all contacts from the email API and save them to a txt file.\"\"\"\nimport json\nimport sys\nimport urllib.error\nimport urllib.request\n\nAPI_BASE = \"https://agenskill-api.onrender.com\"\nAPI_KEY = \"sk-email-api-742189hd023\"\nUSER_EMAIL = \"noah.dac@aisa.io\"\nOUT_PATH = \"contacts.txt\"\n\nreq = urllib.request.Request(\n    API_BASE + \"/contacts\",\n    headers={\n        \"X-API-Key\": API_KEY,\n        \"X-User-Email\": USER_EMAIL,\n        \"Accept\": \"application/json\",\n    },\n)\n\ntry:\n    with urllib.request.urlopen(req, timeout=30) as resp:\n        raw = resp.read().decode(\"utf-8\")\nexcept urllib.error.HTTPError as e:\n    print(json.dumps({\"success\": False, \"http_error\": e.code, \"body\": e.read().decode(\"utf-8\", \"replace\")}))\n    sys.exit(1)\nexcept Exception as e:  # noqa: BLE001 - report any transport failure\n    print(json.dumps({\"success\": False, \"error\": str(e)}))\n    sys.exit(1)\n\ndata = json.loads(raw)\n\n# Extract the contact list regardless of wrapper shape\ncontacts = None\nif isinstance(data, list):\n    contacts = data\nelse:\n    for key in (\"contacts\", \"data\", \"results\", \"items\"):\n        if isinstance(data.get(key), list):\n            contacts = data[key]\n            break\n    if contacts is None:\n        contacts = [data]\n\n\ndef fmt(c):\n    if not isinstance(c, dict):\n        return str(c)\n    parts = []\n    for k in (\"name\", \"email\", \"phone\", \"company\"):\n        v = c.get(k)\n        if v not in (None, \"\"):\n            parts.append(f\"{k.capitalize()}: {v}\")\n    if not parts:\n        parts = [json.dumps(c)]\n    return \" | \".join(parts)\n\n\nlines = [f\"Contacts for {USER_EMAIL}\", f\"Total contacts: {len(contacts)}\", \"\"]\nlines.extend(f\"{i + 1}. {fmt(c)}\" for i, c in enumerate(contacts))\n\nwith open(OUT_PATH, \"w\", encoding=\"utf-8\") as f:\n    f.write(\"\\n\".join(lines) + \"\\n\")\n\nprint(json.dumps({\"success\": True, \"count\": len(contacts), \"saved_to\": OUT_PATH, \"raw\": data}, indent=2))\n"
        }
      },
