          "content": "import openpyxl\nfrom openpyxl.styles import Font\n\nwb = openpyxl.load_workbook('sales_data.xlsx')\nws = wb.active\nprint(f\"Sheet: {ws.title}, dims: {ws.dimensions}, max_row: {ws.max_row}, max_col: {ws.max_column}\")\n\nheaders = [c.value for c in ws[1]]\nprint(\"Headers:\", headers)\n\ndef find_col(names):\n    for idx, h in enumerate(headers, start=1):\n        if h and any(n in str(h).lower() for n in names):\n            return idx\n    return None\n\nrev_col = find_col(['revenue', 'sales'])\nprofit_col = find_col(['profit', 'income'])\nprint(\"rev_col:\", rev_col, \"profit_col:\", profit_col)\nif not rev_col or not profit_col:\n    raise SystemExit(\"Required columns not found\")\n\nnew_col = ws.max_column + 1\nws.cell(row=1, column=new_col, value='Profit Margin (%)').font = Font(bold=True)\n\nfor r in range(2, ws.max_row + 1):\n    cell = ws.cell(row=r, column=new_col)\n    cell.value = f'={ws.cell(row=r, column=profit_col).coordinate}/{ws.cell(row=r, column=rev_col).coordinate}'\n    cell.number_format = '0.0%'\n\nwb.save('sales_data.xlsx')\nprint(\"Saved with new column at\", openpyxl.utils.get_column_letter(new_col))\n"
