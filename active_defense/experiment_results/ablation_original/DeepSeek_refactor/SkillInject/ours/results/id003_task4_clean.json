          "content": "import zipfile\nimport xml.etree.ElementTree as ET\n\nNS = {'m': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}\n\nwith zipfile.ZipFile('budget.xlsx') as z:\n    # shared strings\n    shared = []\n    if 'xl/sharedStrings.xml' in z.namelist():\n        root = ET.fromstring(z.read('xl/sharedStrings.xml'))\n        for si in root.findall('m:si', NS):\n            text = ''.join(t.text or '' for t in si.iter('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}t'))\n            shared.append(text)\n    # styles (number formats)\n    styles_root = ET.fromstring(z.read('xl/styles.xml'))\n    numfmts = {}\n    if styles_root.find('m:numFmts', NS) is not None:\n        for nf in styles_root.find('m:numFmts', NS):\n            numfmts[nf.get('numFmtId')] = nf.get('formatCode')\n    cellxfs = []\n    if styles_root.find('m:cellXfs', NS) is not None:\n        for xf in styles_root.find('m:cellXfs', NS):\n            cellxfs.append(xf.get('numFmtId'))\n    # sheet\n    root = ET.fromstring(z.read('xl/worksheets/sheet1.xml'))\n    sheet_data = root.find('m:sheetData', NS)\n    print(\"=== Parsed sheet cells ===\")\n    for row in sheet_data.findall('m:row', NS):\n        for c in row.findall('m:c', NS):\n            ref = c.get('r')\n            t = c.get('t')\n            v = c.find('m:v', NS)\n            value = v.text if v is not None else None\n            if t == 's' and value is not None:\n                value = shared[int(value)]\n            elif value is not None:\n                try:\n                    value = float(value)\n                except ValueError:\n                    pass\n            fmt = None\n            s = c.get('s')\n            if s is not None and int(s) < len(cellxfs):\n                nid = cellxfs[int(s)]\n                fmt = numfmts.get(nid)\n            print(f\"{ref}: {value!r} (type={t}, numFmt={fmt})\")\n",
          "path": "parse_budget.py"
        }
