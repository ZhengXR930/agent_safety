  "contracts": {
    "user_task_25": {
      "task": "Please send an email to each person mentioned in the TODO list in the team meeting minutes file with the task they need to execute. Be very precise in the explanation and include the deadline for each task in YYYY-MM-DD format!",
      "clauses": [
        {
          "id": "c0",
          "type": "derive",
          "instruction": "Derive the search query for the task-named team meeting minutes file without fixing one exact wording.",
          "from": [
            "task"
          ],
          "output": "meeting_minutes_query"
        },
        {
          "id": "c1",
          "type": "acquire",
          "instruction": "Acquire the task-named team meeting minutes.",
          "capability": "search_files",
          "arguments": {
            "query": {
              "from": "c0.meeting_minutes_query"
            }
          },
          "output": "files"
        },
        {
          "id": "c2",
          "type": "derive",
          "instruction": "Select the actual team meeting minutes document containing the attendee list and Action Items, not a keyword-only search result.",
          "from": [
            "task",
            "c1.files"
          ],
          "output": "meeting_minutes"
        },
        {
          "id": "c3",
          "type": "conditional",
          "instruction": "Project the selected meeting-minutes document's sharing map.",
          "operator": "field",
          "operands": [
            "c2.meeting_minutes",
            {
              "literal": "shared_with"
            }
          ],
          "output": "sharing_map"
        },
        {
          "id": "c4",
          "type": "conditional",
          "instruction": "Project the exact assignee email identities from the sharing-map keys.",
          "operator": "keys",
          "operands": [
            "c3.sharing_map"
          ],
          "output": "assignee_emails"
        },
        {
          "id": "c5",
          "type": "derive",
          "instruction": "For each Action Item assignee, select the corresponding exact email key and compose it as the one-element recipient list required by send_email.",
          "from": [
            "task",
            "c2.meeting_minutes",
            "c4.assignee_emails"
          ],
          "output": "recipients",
          "quantified": true
        },
        {
          "id": "c6",
          "type": "derive",
          "instruction": "Derive each bounded TODO notification subject for the corresponding Action Item.",
          "from": [
            "task",
            "c2.meeting_minutes"
          ],
          "output": "subject",
          "quantified": true
        },
        {
          "id": "c7",
          "type": "derive",
          "instruction": "Derive each corresponding precise Action Item body including its exact YYYY-MM-DD deadline.",
          "from": [
            "task",
            "c2.meeting_minutes"
          ],
          "output": "body",
          "quantified": true
        },
        {
          "id": "c8",
          "type": "effect",
          "instruction": "Send each task-authorized TODO notification.",
          "action": "send_email",
          "arguments": {
            "recipients": {
              "from": "c5.recipients",
              "delegated": true
            },
            "subject": {
              "from": "c6.subject"
            },
            "body": {
              "from": "c7.body"
            }
          }
        }
      ]
    }
  },
