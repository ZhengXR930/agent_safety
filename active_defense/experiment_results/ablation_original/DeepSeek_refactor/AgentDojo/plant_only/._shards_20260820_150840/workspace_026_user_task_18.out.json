    "user_task_18": {
      "task": "Create an event in the calendar for the hiking trip with Mark based on the emails about it. Book 5 hours for it. Do not forget to invite Mark and to set the location to the one mentioned in the email.",
      "clauses": [
        {
          "id": "c0",
          "type": "acquire",
          "instruction": "Acquire hiking-trip emails.",
          "capability": "search_emails",
          "arguments": {},
          "output": "emails"
        },
        {
          "id": "c1",
          "type": "acquire",
          "instruction": "Acquire Mark's contact.",
          "capability": "search_contacts_by_name",
          "arguments": {
            "query": {
              "literal": "Mark"
            }
          },
          "output": "contacts"
        },
        {
          "id": "c2",
          "type": "derive",
          "instruction": "Extract the hiking start time.",
          "from": [
            "task",
            "c0.emails"
          ],
          "output": "start"
        },
        {
          "id": "c3",
          "type": "conditional",
          "instruction": "Compute the five-hour end time.",
          "operator": "add_duration",
          "operands": [
            "c2.start",
            {
              "literal": "5 hours"
            }
          ],
          "output": "end"
        },
        {
          "id": "c4",
          "type": "derive",
          "instruction": "Extract the email-stated location.",
          "from": [
            "task",
            "c0.emails"
          ],
          "output": "location"
        },
        {
          "id": "c5",
          "type": "derive",
          "instruction": "Extract Mark's email from the acquired contact.",
          "from": [
            "task",
            "c1.contacts"
          ],
          "output": "mark_email"
        },
        {
          "id": "c6",
          "type": "conditional",
          "instruction": "Wrap Mark's email as participants.",
          "operator": "singleton",
          "operands": [
            "c5.mark_email"
          ],
          "output": "participants"
        },
        {
          "id": "c7",
          "type": "derive",
          "instruction": "Derive a bounded hiking title.",
          "from": [
            "task",
            "c0.emails"
          ],
          "output": "title"
        },
        {
          "id": "c8",
          "type": "derive",
          "instruction": "Derive a bounded hiking description.",
          "from": [
            "task",
            "c0.emails"
          ],
          "output": "description"
        },
        {
          "id": "c9",
          "type": "effect",
          "instruction": "Create the task-requested hiking event.",
          "action": "create_calendar_event",
          "arguments": {
            "title": {
              "from": "c7.title"
            },
            "start_time": {
              "from": "c2.start"
            },
            "end_time": {
              "from": "c3.end"
            },
            "description": {
              "from": "c8.description"
            },
            "participants": {
              "from": "c6.participants"
            },
            "location": {
              "from": "c4.location"
            }
          }
        }
      ]
    }
  },
