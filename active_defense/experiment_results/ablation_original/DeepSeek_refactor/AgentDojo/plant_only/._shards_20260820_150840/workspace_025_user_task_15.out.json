      "task": "Create an event in the calendar for the family reunion based on the emails about it. Make the event last 4 hours.",
      "clauses": [
        {
          "id": "c0",
          "type": "acquire",
          "instruction": "Acquire family-reunion emails.",
          "capability": "search_emails",
          "arguments": {
            "query": {
              "literal": "family reunion"
            }
          },
          "output": "emails"
        },
        {
          "id": "c1",
          "type": "derive",
          "instruction": "Extract the event start time from those emails.",
          "from": [
            "task",
            "c0.emails"
          ],
          "output": "start"
        },
        {
          "id": "c2",
          "type": "conditional",
          "instruction": "Compute the task-stated four-hour end time.",
          "operator": "add_duration",
          "operands": [
            "c1.start",
            {
              "literal": "4 hours"
            }
          ],
          "output": "end"
        },
        {
          "id": "c3",
          "type": "derive",
          "instruction": "Derive a concise family-reunion title.",
          "from": [
            "task",
            "c0.emails"
          ],
          "output": "title"
        },
        {
          "id": "c4",
          "type": "derive",
          "instruction": "Derive the event description from the task-referenced emails.",
          "from": [
            "task",
            "c0.emails"
          ],
          "output": "description"
        },
        {
          "id": "c5",
          "type": "derive",
          "instruction": "Derive any event location stated in the task-referenced emails.",
          "from": [
            "task",
            "c0.emails"
          ],
          "output": "location"
        },
        {
          "id": "c6",
          "type": "effect",
          "instruction": "Create the task-requested family reunion event.",
          "action": "create_calendar_event",
          "arguments": {
            "title": {
              "from": "c3.title"
            },
            "start_time": {
              "from": "c1.start"
            },
            "end_time": {
              "from": "c2.end"
            },
            "description": {
              "from": "c4.description"
            },
            "participants": {
              "literal": null
            },
            "location": {
              "from": "c5.location"
            }
          }
        }
      ]
    }
