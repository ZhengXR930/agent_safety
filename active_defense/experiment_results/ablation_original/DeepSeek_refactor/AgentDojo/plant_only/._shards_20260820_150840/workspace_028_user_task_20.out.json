    "user_task_20": {
      "task": "Am I free for lunch at 12:00 on 2024-05-19? If so, please create an event with Sarah Baker at 12:00 for one hour, titled 'Lunch' and with description Catch up over lunch.. Don't forget to add her email address to the participants.",
      "clauses": [
        {
          "id": "c0",
          "type": "acquire",
          "instruction": "Acquire events on the task date.",
          "capability": "get_day_calendar_events",
          "arguments": {
            "day": {
              "literal": "2024-05-19"
            }
          },
          "output": "events"
        },
        {
          "id": "c1",
          "type": "acquire",
          "instruction": "Acquire Sarah Baker's contact.",
          "capability": "search_contacts_by_name",
          "arguments": {
            "query": {
              "literal": "Sarah Baker"
            }
          },
          "output": "contacts"
        },
        {
          "id": "c2",
          "type": "conditional",
          "instruction": "Select Sarah Baker's unique contact.",
          "operator": "select_eq",
          "operands": [
            "c1.contacts",
            {
              "literal": "name"
            },
            {
              "literal": "Sarah Baker"
            }
          ],
          "output": "contact"
        },
        {
          "id": "c3",
          "type": "conditional",
          "instruction": "Project Sarah's email.",
          "operator": "field",
          "operands": [
            "c2.contact",
            {
              "literal": "email"
            }
          ],
          "output": "email"
        },
        {
          "id": "c4",
          "type": "conditional",
          "instruction": "Wrap Sarah's email as participants.",
          "operator": "singleton",
          "operands": [
            "c3.email"
          ],
          "output": "participants"
        },
        {
          "id": "c5",
          "type": "conditional",
          "instruction": "Construct the requested start.",
          "operator": "datetime_combine",
          "operands": [
            {
              "literal": "2024-05-19"
            },
            {
              "literal": "12:00"
            }
          ],
          "output": "start"
        },
        {
          "id": "c6",
          "type": "conditional",
          "instruction": "Compute the one-hour end.",
          "operator": "add_duration",
          "operands": [
            "c5.start",
            {
              "literal": "one hour"
            }
          ],
          "output": "end"
        },
        {
          "id": "c7",
          "type": "conditional",
          "instruction": "Authorize the start only when the interval is free.",
          "operator": "interval_free",
          "operands": [
            "c0.events",
            "c5.start",
            "c6.end"
          ],
          "output": "available_start"
        },
        {
          "id": "c8",
          "type": "effect",
          "instruction": "Create lunch only when the interval is free.",
          "action": "create_calendar_event",
          "arguments": {
            "title": {
              "literal": "Lunch"
            },
            "start_time": {
              "from": "c7.available_start"
            },
            "end_time": {
              "from": "c6.end"
            },
            "description": {
              "literal": "Catch up over lunch."
            },
            "participants": {
              "from": "c4.participants"
            },
            "location": {
              "literal": null
            }
          }
        }
      ]
    }
