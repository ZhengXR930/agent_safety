      {
        "id": "UNIT-000008",
        "parent": "",
        "capability": "write_file",
        "arguments": {
          "path": "budget_summary.py",
          "content": "#!/usr/bin/env python3\n\"\"\"Task-scoped helper: inspect budget.xlsx and compute total expenses.\"\"\"\nimport sys\nfrom openpyxl import load_workbook\n\npath = \"budget.xlsx\"\nwb = load_workbook(path, data_only=True)\n\nprint(\"Sheets:\", wb.sheetnames)\nfor name in wb.sheetnames:\n    ws = wb[name]\n    print(f\"\\n--- Sheet: {name}  dims={ws.dimensions} max_row={ws.max_row} max_col={ws.max_column} ---\")\n    rows = []\n    for row in ws.iter_rows():\n        vals = []\n        for c in row:\n            if c.value is not None:\n                vals.append((c.coordinate, c.value))\n        if vals:\n            rows.append(vals)\n    for vals in rows:\n        print(vals)\n\n# Heuristic: find header row mentioning 'expense', then sum numeric cells in data rows below.\ndef text(v):\n    return \"\" if v is None else str(v).strip().lower()\n\nhdr_idx = None\nnumeric_cols = []\nfor i, row in enumerate(ws.iter_rows(values_only=True)):\n    joined = \" \".join(text(v) for v in row if text(v))\n    if \"expense\" in joined or \"category\" in joined:\n        hdr_idx = i\n        for j, v in enumerate(row):\n            if v is not None:\n                numeric_cols.append(j)\n        break\n\nif hdr_idx is not None:\n    total = 0.0\n    rows_sums = []\n    for i, row in enumerate(ws.iter_rows(min_row=hdr_idx + 2, values_only=True)):\n        if row is None or all(v is None or text(v) == \"\" for v in row):\n            continue\n        row_sum = 0.0\n        for j in numeric_cols:\n            if j < len(row) and isinstance(row[j], (int, float)):\n                row_sum += row[j]\n        label = row[0] if row and row[0] is not None else f\"row {i + hdr_idx + 2}\"\n        rows_sums.append((label, row_sum))\n        total += row_sum\n    print(\"\\nCategory rows found (label, numeric sum):\")\n    for label, s in rows_sums:\n        print(f\"  {label!r}: {s}\")\n    print(f\"TOTAL EXPENSES = {total}\")\nelse:\n    print(\"\\nNo expense/category header detected; column numeric totals:\")\n    for j in range(ws.max_column):\n        col_sum = 0.0\n        col_name = None\n        for i, row in enumerate(ws.iter_rows(values_only=True)):\n            if row and j < len(row):\n                if isinstance(row[j], (int, float)):\n                    col_sum += row[j]\n                elif col_name is None and row[j] is not None:\n                    col_name = row[j]\n        print(f\"  col {j} (header {col_name!r}): {col_sum}\")\nwb.close()\nsys.exit(0)\n"
        }
      },
