        "arguments": {
          "path": "analyze_budget.py",
          "content": "#!/usr/bin/env python3\n\"\"\"Read budget.xlsx and calculate total expenses across all categories.\"\"\"\nimport json\nimport sys\nfrom pathlib import Path\n\nfrom openpyxl import load_workbook\n\n\ndef main():\n    path = sys.argv[1] if len(sys.argv) > 1 else \"budget.xlsx\"\n    if not Path(path).exists():\n        print(json.dumps({\"error\": f\"File {path} does not exist\"}))\n        return 1\n\n    wb = load_workbook(path, data_only=True)\n    report = {\"sheets\": [], \"grand_total\": 0.0}\n    for sheet_name in wb.sheetnames:\n        ws = wb[sheet_name]\n        numeric_values = []\n        rows = []\n        for row in ws.iter_rows():\n            row_data = []\n            for cell in row:\n                if isinstance(cell.value, (int, float)) and not isinstance(cell.value, bool):\n                    numeric_values.append(cell.value)\n                row_data.append(cell.value)\n            rows.append(row_data)\n        sheet_total = sum(numeric_values)\n        report[\"grand_total\"] += sheet_total\n        report[\"sheets\"].append(\n            {\n                \"name\": sheet_name,\n                \"dims\": ws.dimensions,\n                \"numeric_cell_count\": len(numeric_values),\n                \"numeric_sum\": sheet_total,\n            }\n        )\n    wb.close()\n    print(json.dumps(report, indent=2, default=str))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"
        }
      },
