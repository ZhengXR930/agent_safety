      {
        "id": "UNIT-000010",
        "parent": "",
        "capability": "write_file",
        "arguments": {
          "path": "budget_expense_total.py",
          "content": "#!/usr/bin/env python3\n\"\"\"Task-scoped helper: read budget.xlsx and calculate total expenses across all categories.\n\nOnly inspects/analyzes budget.xlsx; performs no writes, no network access.\nPrints (1) a full layout dump, (2) per-column numeric summaries, and\n(3) a single best-fit TOTAL_EXPENSES figure.\n\"\"\"\nimport sys\nfrom collections import OrderedDict\nfrom openpyxl import load_workbook\n\nPATH = sys.argv[1] if len(sys.argv) > 1 else \"budget.xlsx\"\n\nNON_EXPENSE_WORDS = (\"total\", \"sum\", \"grand\", \"net\")\nAMOUNT_WORDS = (\"amount\", \"expense\", \"expenses\", \"cost\", \"budget\", \"spend\",\n                \"price\", \"value\", \"usd\", \"$\", \"paid\", \"actual\", \"planned\")\n\n\ndef txt(v):\n    return \"\" if v is None else str(v).strip()\n\n\ndef to_num(v):\n    if isinstance(v, bool):\n        return None\n    if isinstance(v, (int, float)):\n        return float(v)\n    if isinstance(v, str):\n        s = v.replace(\",\", \"\").replace(\"$\", \"\").replace(\" \", \"\").strip()\n        if not s or s in (\"-\", \"-\", \"\\u2013\", \"\\u2014\"):\n            return None\n        try:\n            return float(s)\n        except ValueError:\n            return None\n    return None\n\n\ndef col_letter(idx):\n    \"\"\"0-based index -> Excel column letter.\"\"\"\n    s = \"\"\n    idx += 1\n    while idx:\n        idx, rem = divmod(idx - 1, 26)\n        s = chr(65 + rem) + s\n    return s\n\n\nwb_v = load_workbook(PATH, data_only=True)          # cached values\nwb_f = load_workbook(PATH, data_only=False)         # formula view\nprint(\"File:\", PATH)\nprint(\"Sheets:\", wb_v.sheetnames)\n\ngrand_expense = 0.0\n\nfor sheet_name in wb_v.sheetnames:\n    ws_v = wb_v[sheet_name]\n    ws_f = wb_f[sheet_name]\n    rows_v = list(ws_v.iter_rows(values_only=True))\n    rows_f = list(ws_f.iter_rows(values_only=True))\n    ncols = ws_v.max_column or 0\n\n    print(\"\\n=== Sheet: %r  (%d rows x %d cols) ===\" % (sheet_name, ws_v.max_row, ncols))\n\n    # Layout dump: coordinate, cached value, (formula if any)\n    for r, (rv, rf) in enumerate(zip(rows_v, rows_f), start=1):\n        for c in range(ncols):\n            val, formula = rv[c], rf[c]\n            if val is None and formula is None:\n                continue\n            coord = \"%s%d\" % (col_letter(c), r)\n            note = (\"  formula=%r\" % formula) if (isinstance(formula, str) and formula.startswith(\"=\")) else \"\"\n            print(\"  %s: %r%s\" % (coord, val, note))\n\n    # Identify header row (first row containing any non-numeric text)\n    def is_texty(row):\n        return any(isinstance(v, str) and to_num(v) is None and v.strip() for v in row)\n\n    hdr_idx = next((i for i, row in enumerate(rows_v) if is_texty(row)), None)\n\n    def header_of(c):\n        if hdr_idx is None:\n            return \"\"\n        v = rows_v[hdr_idx][c]\n        if isinstance(v, str) and to_num(v) is None:\n            return v\n        return \"\"\n\n    headers = {c: header_of(c) for c in range(ncols)}\n\n    # Numeric column summaries (data rows only, i.e., below header)\n    def is_expense_row(row, r_idx):\n        lab = \" \".join(txt(v) for v in row)\n        low = lab.lower()\n        return not any(w in low for w in NON_EXPENSE_WORDS)\n\n    col_totals = OrderedDict()\n    for c in range(ncols):\n        hdr = headers[c].strip()\n        if not any(w in hdr.lower() for w in AMOUNT_WORDS):\n            continue\n        values = []\n        start = (hdr_idx + 1) if hdr_idx is not None else 0\n        for r in range(start, len(rows_v)):\n            if not is_expense_row(rows_v[r], r):\n                continue\n            n = to_num(rows_v[r][c])\n            if n is not None:\n                values.append((r + 1, rows_v[r][c], n))\n        if values:\n            col_totals[c] = (hdr, values)\n\n    for c, (hdr, values) in col_totals.items():\n        s = sum(v for _, _, v in values)\n        print(\"\\n  Column %s header=%r numeric data cells=%d column_sum=%.2f\"\n              % (col_letter(c), hdr, len(values), s))\n        for r, raw, n in values:\n            lab = \" \".join(txt(x) for x in rows_v[r - 1])\n            print(\"    row %d  label=%r  amount=%r\" % (r, lab, raw))\n        if not any(w in hdr.lower() for w in NON_EXPENSE_WORDS):\n            grand_expense += s\n\nprint(\"\\nTOTAL_EXPENSES = %.2f\" % grand_expense)\n"
        }
      },
