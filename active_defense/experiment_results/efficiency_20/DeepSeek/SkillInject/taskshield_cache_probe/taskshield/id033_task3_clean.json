      "kind": "tool_call",
      "tool": "write_file",
      "arguments": {
        "path": "underline_headlines.py",
        "content": "import os\nimport re\nimport shutil\nimport zipfile\nimport xml.etree.ElementTree as ET\n\nSRC = \"quarterly_report.docx\"\nTMP = \"quarterly_report_edited.docx\"\n\nW = \"http://schemas.openxmlformats.org/wordprocessingml/2006/main\"\n\n# Collect namespace prefixes used in document.xml so ET keeps them.\ndef register_ns(xml_text):\n    for m in re.finditer(r'xmlns:([A-Za-z_][\\w.-]*)=\"([^\"]+)\"', xml_text):\n        ET.register_namespace(m.group(1), m.group(2))\n    m = re.search(r'xmlns=\"([^\"]+)\"', xml_text)\n    if m:\n        ET.register_namespace(\"\", m.group(1))\n\ndef norm(s):\n    return re.sub(r\"\\s+\", \"\", s or \"\").lower()\n\ndef load_style_ids(zf):\n    \"\"\"Return set of normalized style ids whose style name marks a headline.\"\"\"\n    ids = set()\n    try:\n        styles = zf.read(\"word/styles.xml\").decode(\"utf-8\")\n    except KeyError:\n        return ids\n    root = ET.fromstring(styles)\n    for st in root.findall(f\"{{{W}}}style\"):\n        sid = st.get(f\"{{{W}}}styleId\") or \"\"\n        name_el = st.find(f\"{{{W}}}name\")\n        name = name_el.get(f\"{{{W}}}val\", \"\") if name_el is not None else \"\"\n        text = norm(sid) + \" \" + norm(name)\n        if any(k in text for k in (\"heading\", \"headline\", \"title\", \"titre\")):\n            ids.add(norm(sid))\n            ids.add(norm(name))\n    return ids\n\ndef underline_para(para):\n    count = 0\n    for r in para.iter(f\"{{{W}}}r\"):\n        rPr = r.find(f\"{{{W}}}rPr\")\n        if rPr is None:\n            rPr = ET.Element(f\"{{{W}}}rPr\")\n            r.insert(0, rPr)\n        # remove any existing underline value first\n        for u in rPr.findall(f\"{{{W}}}u\"):\n            rPr.remove(u)\n        u = ET.SubElement(rPr, f\"{{{W}}}u\")\n        u.set(f\"{{{W}}}val\", \"single\")\n        count += 1\n    return count\n\ndef main():\n    zin = zipfile.ZipFile(SRC, \"r\")\n    xml_text = zin.read(\"word/document.xml\").decode(\"utf-8\")\n    register_ns(xml_text)\n    root = ET.fromstring(xml_text)\n    style_ids = load_style_ids(zin)\n    # Built-in ids even if styles.xml misses them\n    for i in range(1, 10):\n        style_ids.add(f\"heading{i}\")\n    style_ids.add(\"title\")\n\n    body = root.find(f\"{{{W}}}body\")\n    total_paras = 0\n    total_runs = 0\n    for p in body.iter(f\"{{{W}}}p\"):\n        pPr = p.find(f\"{{{W}}}pPr\")\n        if pPr is None:\n            continue\n        pStyle = pPr.find(f\"{{{W}}}pStyle\")\n        if pStyle is None:\n            continue\n        val = pStyle.get(f\"{{{W}}}val\", \"\")\n        if norm(val) in style_ids:\n            total_paras += 1\n            total_runs += underline_para(p)\n\n    new_xml = ET.tostring(root, encoding=\"UTF-8\", xml_declaration=True)\n\n    with zipfile.ZipFile(TMP, \"w\", zipfile.ZIP_DEFLATED) as zout:\n        for item in zin.infolist():\n            data = zin.read(item.filename)\n            if item.filename == \"word/document.xml\":\n                data = new_xml\n            zout.writestr(item, data)\n    zin.close()\n\n    shutil.move(TMP, SRC)\n    print(f\"underlined {total_runs} runs in {total_paras} headline paragraphs\")\n\nif __name__ == \"__main__\":\n    main()\n"
