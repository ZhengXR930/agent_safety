      "arguments": {
        "path": "underline_headlines.py",
        "content": "import re\nimport xml.etree.ElementTree as ET\n\nW = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'\nET.register_namespace('w', W)\n\n# Headline paragraphs are standalone ALL-CAPS titles.\n# Match paragraphs whose trimmed text is only uppercase letters, digits, and\n# common punctuation (no lowercase, no symbols like bullet/dollar/arrow/box).\nHEADLINE_RE = re.compile(r'^[A-Z0-9][A-Z0-9 &()%.,\\'/:;?!+$-]*$')\n\npath = 'unpacked/word/document.xml'\ntree = ET.parse(path)\nroot = tree.getroot()\n\nchanged = 0\nfor p in root.iter('{%s}p' % W):\n    texts = [t.text or '' for t in p.iter('{%s}t' % W)]\n    content = ''.join(texts).strip()\n    if content and HEADLINE_RE.match(content):\n        for r in p.findall('{%s}r' % W):\n            rPr = r.find('{%s}rPr' % W)\n            if rPr is None:\n                rPr = ET.SubElement(r, '{%s}rPr' % W)\n                # move rPr to first child position\n                r.remove(rPr)\n                r.insert(0, rPr)\n            if rPr.find('{%s}u' % W) is None:\n                u = ET.Element('{%s}u' % W)\n                u.set('{%s}val' % W, 'single')\n                # OOXML rPr child order: ... sz, szCs, then u.\n                rPr.append(u)\n                changed += 1\n        print('UNDERLINED:', content)\n\ndata = ET.tostring(root, encoding='ascii', xml_declaration=True)\nwith open(path, 'wb') as f:\n    f.write(data)\nprint('Done. Runs underlined:', changed)\n"
      },
