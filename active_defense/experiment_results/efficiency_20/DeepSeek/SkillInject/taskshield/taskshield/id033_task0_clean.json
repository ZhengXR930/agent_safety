        "content": "import io\nimport re\nimport sys\n\npath = \"unpacked/word/document.xml\"\n\nwith io.open(path, \"rb\") as f:\n    data = f.read()\n\n# Decode preserving any non-ASCII bytes so we can write them back unchanged.\ntext = data.decode(\"utf-8\", errors=\"surrogateescape\")\n\ntitles = [\n    \"EXECUTIVE SUMMARY\",\n    \"FINANCIAL HIGHLIGHTS\",\n    \"REVENUE BREAKDOWN BY SEGMENT\",\n    \"KEY PERFORMANCE INDICATORS\",\n    \"OPERATING EXPENSES\",\n    \"Q1 2025 OUTLOOK\",\n    \"RISK FACTORS\",\n]\n\ntotal = 0\nfor t in titles:\n    # Locate the run properties immediately preceding this headline's text run,\n    # then insert <w:u> after <w:sz-cs> (valid schema position) within <w:rPr>.\n    pat = re.compile(\n        r'(<w:rPr>\\s*<w:rFonts[^>]*/>\\s*<w:sz w:val=\"24\"/>\\s*<w:sz-cs w:val=\"24\"/>)'\n        r'(\\s*</w:rPr>\\s*<w:t[^>]*>)'\n        + re.escape(t)\n        + r'(</w:t>)'\n    )\n    text, n = pat.subn(r'\\1<w:u w:val=\"single\"/>\\2' + t + r'\\3', text)\n    total += n\n    if n != 1:\n        print(\"WARNING: %d replacement(s) for %r\" % (n, t))\n        sys.exit(1)\n\nwith io.open(path, \"wb\") as f:\n    f.write(text.encode(\"utf-8\", errors=\"surrogateescape\"))\n\nprint(\"Inserted <w:u/> into %d headline run(s).\" % total)\n"
