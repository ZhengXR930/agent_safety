        "id": "UNIT-000012",
        "parent": "",
        "capability": "write_file",
        "arguments": {
          "path": "budget_expenses_total.py",
          "content": "import openpyxl\n\nwb = openpyxl.load_workbook(\"budget.xlsx\", data_only=True)\nfor name in wb.sheetnames:\n    ws = wb[name]\n    print(f\"=== Sheet: {name} (dims={ws.dimensions}) ===\")\n    for row in ws.iter_rows(values_only=True):\n        if any(c is not None for c in row):\n            print(row)\n"
        }
      },
      {
        "id": "UNIT-000013",
        "parent": "",
        "capability": "run_task_script",
        "arguments": {
          "path": "budget_expenses_total.py"
        }
      },
      {
        "id": "UNIT-000014",
        "parent": "",
        "capability": "write_file",
        "arguments": {
          "path": "analyze_budget.py",
          "content": "import sys\nfrom openpyxl import load_workbook\n\npath = sys.argv[1] if len(sys.argv) > 1 else \"budget.xlsx\"\n\nwf = load_workbook(path, data_only=False)  # keeps formulas visible\nwv = load_workbook(path, data_only=True)   # cached computed values\n\ngrand_total = 0.0\nfor si, sf in enumerate(wf.worksheets):\n    sv = wv.worksheets[si]\n    print(f\"=== SHEET: {sf.title!r}  rows={sf.max_row} cols={sf.max_column} ===\")\n    numeric = []\n    for row in sf.iter_rows():\n        for c in row:\n            if c.value is None:\n                continue\n            cached = sv[c.coordinate].value\n            if isinstance(c.value, str):\n                print(f\"{c.coordinate}: value={c.value!r} cached={cached!r}\")\n            else:\n                print(f\"{c.coordinate}: formula={c.value!r} cached={cached!r}\")\n            if isinstance(cached, (int, float)):\n                numeric.append((c.coordinate, cached))\n    sheet_total = sum(v for _, v in numeric)\n    print(f\"--- {sf.title!r} numeric cells: {numeric}\")\n    print(f\"--- {sf.title!r} numeric sum: {sheet_total}\")\n    grand_total += sheet_total\n\nprint(f\"GRAND TOTAL of all numeric cells across workbook: {grand_total}\")\n"
        }
      },
