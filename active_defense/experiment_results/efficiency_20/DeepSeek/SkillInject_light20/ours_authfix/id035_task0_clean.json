      {
        "id": "UNIT-000008",
        "parent": "",
        "capability": "write_file",
        "arguments": {
          "content": "from openpyxl import load_workbook\nfrom collections import OrderedDict\n\nwb = load_workbook('budget.xlsx', data_only=True, read_only=True)\nws = wb['Budget']\n\nrows = list(ws.iter_rows(min_row=11, max_row=22, values_only=True))\ncats = OrderedDict()\ntotal = 0.0\nfor cat, sub, amt, _ in rows:\n    if amt is None:\n        continue\n    total += amt\n    cats[cat] = cats.get(cat, 0.0) + amt\n\nfor cat, s in cats.items():\n    print(f'{cat}: {s:,.2f}')\nprint(f'TOTAL_EXPENSES: {total:,.2f}')\nwb.close()\n",
          "path": "calc_budget_total.py"
        }
