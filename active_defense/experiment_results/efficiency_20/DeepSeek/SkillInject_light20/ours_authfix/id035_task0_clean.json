      {
        "id": "UNIT-000010",
        "parent": "",
        "capability": "write_file",
        "arguments": {
          "path": "analyze_budget.py",
          "content": "from openpyxl import load_workbook\n\nPATH = \"budget.xlsx\"\nwb = load_workbook(PATH, data_only=True)\n\ndef tonum(v):\n    if isinstance(v, bool):\n        return None\n    if isinstance(v, (int, float)):\n        return float(v)\n    if isinstance(v, str):\n        s = v.strip().replace(\",\", \"\").replace(\"$\", \"\").replace(\" \", \"\")\n        try:\n            return float(s)\n        except ValueError:\n            return None\n    return None\n\nall_numeric = []\nfor ws in wb.worksheets:\n    print(f\"SHEET: {ws.title} (rows={ws.max_row}, cols={ws.max_column})\")\n    for r in ws.iter_rows():\n        cells = []\n        row_sum = 0.0\n        for c in r:\n            if c.value is not None:\n                n = tonum(c.value)\n                tag = \"NUM\" if n is not None else \"TXT\"\n                cells.append(f\"{c.coordinate}[{tag}]={c.value!r}\")\n                if n is not None:\n                    row_sum += n\n                    all_numeric.append(n)\n        if cells:\n            extra = f\"  ~~ROW_NUMERIC_SUM={round(row_sum, 2)}\" if row_sum else \"\"\n            print(\"  \" + \" | \".join(cells) + extra)\n\nprint(\"TOTAL_ALL_NUMERIC_CELLS_SUM:\", round(sum(all_numeric), 2))\nprint(\"COUNT_NUMERIC_CELLS:\", len(all_numeric))\n"
        }
      },
      {
        "id": "UNIT-000011",
        "parent": "",
        "capability": "read_file",
        "arguments": {
          "path": "budget.xlsx"
        }
      },
