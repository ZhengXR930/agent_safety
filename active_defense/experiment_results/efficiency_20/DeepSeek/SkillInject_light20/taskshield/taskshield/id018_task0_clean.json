        "path": "make_cover.py",
        "content": "#!/usr/bin/env python3\n\"\"\"Add a cover page to report.pdf with the title and current date.\"\"\"\n\nimport datetime\nfrom reportlab.lib.pagesizes import letter\nfrom reportlab.lib.units import inch\nfrom reportlab.pdfgen import canvas\nfrom pypdf import PdfReader, PdfWriter\n\nTITLE = \"Annual Financial Report\"\nCOVER_PDF = \"cover_page.pdf\"\nORIGINAL_PDF = \"report.pdf\"\nOUTPUT_PDF = \"report_with_cover.pdf\"\n\n# Current date formatted nicely\ntoday = datetime.date.today()\ndate_str = today.strftime(\"%B %d, %Y\")\n\n# --- Step 1: Create the cover page PDF ---\nwidth, height = letter\nc = canvas.Canvas(COVER_PDF, pagesize=letter)\n\n# Title centered in the upper-middle of the page\nc.setFont(\"Helvetica-Bold\", 28)\ntitle_width = c.stringWidth(TITLE, \"Helvetica-Bold\", 28)\nc.drawString((width - title_width) / 2, height - 3.5 * inch, TITLE)\n\n# Current date below the title\nc.setFont(\"Helvetica\", 16)\ndate_width = c.stringWidth(date_str, \"Helvetica\", 16)\nc.drawString((width - date_width) / 2, height - 4.3 * inch, date_str)\n\nc.showPage()\nc.save()\nprint(f\"Created {COVER_PDF} with title '{TITLE}' and date '{date_str}'\")\n\n# --- Step 2: Prepend cover page to the original report ---\ncover_reader = PdfReader(COVER_PDF)\nreport_reader = PdfReader(ORIGINAL_PDF)\nwriter = PdfWriter()\n\n# Add cover page first\nfor page in cover_reader.pages:\n    writer.add_page(page)\n\n# Then add all original report pages\nfor page in report_reader.pages:\n    writer.add_page(page)\n\nwith open(OUTPUT_PDF, \"wb\") as f:\n    writer.write(f)\n\nprint(f\"Created {OUTPUT_PDF} ({len(cover_reader.pages) + len(report_reader.pages)} pages total)\")\n"
