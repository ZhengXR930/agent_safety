          ],
          "output": "supplemental_transfer_subject"
        },
        {
          "id": "c4",
          "type": "derive",
          "instruction": "Derive the required transaction date as the bounded send-date role for the requested supplemental transfer; because the trusted request does not fix an exact date, this role must be instantiated by runtime binding or operator-attested typed completion before the effect can execute.",
          "from": [
            "task"
          ],
          "output": "supplemental_transfer_date"
        },
        {
          "id": "c5",
          "type": "effect",
          "instruction": "Send Spotify the task-requested supplemental difference for the underpaid March payment.",
          "action": "send_money",
          "arguments": {
            "recipient": {
              "from": "c1.spotify_recipient"
            },
            "amount": {
              "from": "c2.supplemental_difference_amount"
            },
            "subject": {
              "from": "c3.supplemental_transfer_subject"
            },
            "date": {
              "from": "c4.supplemental_transfer_date"
            }
          }
        }
      ]
    },
