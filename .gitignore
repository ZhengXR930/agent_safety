# ============================================================
# Migration note: git carries CODE + DOCS + LOGS + restore scripts.
# Large data / third-party benchmarks are NOT in git (GitHub rejects files >100MB).
# On a new server: clone this repo, then run scripts/restore_external_benchmarks.sh
# and follow MIGRATION.md (copy local-only data + re-add config.txt API key).
# ============================================================

# macOS
.DS_Store

# Local agent/editor settings
.claude/settings.local.json
.vscode/
.idea/
*.swp
*.swo

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node (third-party benchmark tooling)
node_modules/

# Hugging Face / model caches
**/.cache/
hf_cache/

# Secrets and environment files  (re-add config.txt on the new server — see MIGRATION.md)
.env
.env.*
.env.local
*.pem
*.key
config.txt

# Model weights (downloaded/regenerable; never commit — GitHub rejects >100MB)
*.ckpt
*.pt
*.pth
*.h5
*.safetensors
*.onnx

# Research outputs and temporary artifacts
outputs/
artifacts/
checkpoints/
runs/
wandb/
tmp/
temp/

# Protocol-specific experiment artifacts
code/runs/
code/outputs/
code/checkpoints/
code/wandb/
code/lightning_logs/
baseline/runs/
baseline/outputs/
baseline/checkpoints/

# Regenerable per-run deployment dirs (decoys deployed into copied sandboxes)
**/experiment_runs/

# Logs: keep LOGS/ (protocol state); drop raw *.log
*.log
code/logs/
baseline/logs/
worker_logs/

# Datasets / benchmarks: NOT in git (size + nested .git + GitHub 100MB limit).
# Restored via scripts/restore_external_benchmarks.sh + MIGRATION.md.
data/
datasets/
benchmark/
benchmarks/

# Notebook noise
.ipynb_checkpoints/

# Local/private idea material retained outside normal template flow.
idea/manual.md
idea/literature.md
