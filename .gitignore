# macOS
.DS_Store

# Local agent/editor settings
.claude/settings.local.json
.vscode/
.idea/
*.swp
*.swo

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Secrets and environment files
.env
.env.*
.env.local
*.pem
*.key

# Research outputs and temporary artifacts
outputs/
artifacts/
checkpoints/
runs/
wandb/
tmp/
temp/

# Protocol-specific experiment artifacts
code/runs/
code/outputs/
code/checkpoints/
code/wandb/
code/lightning_logs/
baseline/runs/
baseline/outputs/
baseline/checkpoints/
*.ckpt
*.pt
*.pth
*.h5
*.safetensors

# Dataset bodies: commit paths/metadata, not the data itself.
data/
datasets/

# Logs: do not ignore LOGS/ because it is protocol state.
*.log
code/logs/
baseline/logs/

# Notebook noise
.ipynb_checkpoints/

# Local/private idea material retained outside normal template flow.
idea/manual.md
idea/literature.md


benchmark/
benchmarks/
worker_logs/
